[Unit]
Description=Absolute Term public API (/absolute_term)
After=network.target

[Service]
Type=simple
User=admin
Group=www-data
WorkingDirectory=/opt/absolute_term
Environment=ABSOLUTE_SOCK=/run/absolute/absolute.sock
RuntimeDirectory=absolute
RuntimeDirectoryMode=0775
ExecStart=/usr/bin/python3 /opt/absolute_term/api_server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
